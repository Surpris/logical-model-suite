{
  "name": "lms-to-graphql",
  "version": "0.1.0",
  "type": "module",
  "description": "Logical Model Schema to GraphQL Converter",
  "main": "dist/index.js",
  "keywords": [],
  "author": "Surpris & Gemini",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -b",
    "format": "prettier --write \"{src,tests}/*.ts\"",
    "lint": "eslint \"{src,tests}/*.ts\" --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run format && npm run lint && npm run typecheck && npm run build && npm run test",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@lms/core": "*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^20.19.35",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
