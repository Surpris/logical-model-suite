{
  "name": "lms-to-graphql",
  "version": "1.0.0",
  "type": "module",
  "description": "Logical Model Schema to GraphQL Converter",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "start": "tsx src/index.ts",
    "prepublishOnly": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.0"
  }
}
