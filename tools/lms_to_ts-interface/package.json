{
  "name": "lms_to_ts-interface",
  "version": "0.1.0",
  "type": "module",
  "description": "Convert logical data models to TypeScript interfaces",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint \"src/*.ts\" --fix",
    "format": "prettier --write  \"src/*.ts\"",
    "lint:spectral": "spectral lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "prepublishOnly": "npm run format && npm run lint && npm run typecheck && npm run build && npm run test",
    "validate": "node ./dist/bin/lms-val.js",
    "generate": "node ./dist/bin/lms-gen.js",
    "all": "npm run validate && npm run generate"
  },
  "keywords": [],
  "author": "Surpris & Gemini",
  "license": "Apache-2.0",
  "dependencies": {
    "@lms/core": "*",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@stoplight/spectral-cli": "^6.15.0",
    "@stoplight/spectral-functions": "^1.10.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
