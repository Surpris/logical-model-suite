{
  "name": "lms_to_ts-interface",
  "version": "0.1.0",
  "description": "Convert logical data models to TypeScript interfaces",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:spectral": "spectral lint",
    "test": "ts-node ./src/bin/lms-val.ts",
    "type-check": "tsc -b --noEmit",
    "validate": "ts-node ./src/bin/lms-val.ts",
    "generate": "ts-node ./src/bin/lms-gen.ts",
    "all": "npm run validate && npm run generate"
  },
  "keywords": [],
  "author": "Surpris & Gemini",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@lms/core": "*",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@stoplight/spectral-cli": "^6.15.0",
    "@stoplight/spectral-functions": "^1.10.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.9",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
